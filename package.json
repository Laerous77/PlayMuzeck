{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "legal": "node scripts/generate-legal-pages.mjs",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "node scripts/generate-legal-pages.mjs --allow-placeholder && vite --port=3000 --host=0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "node scripts/generate-legal-pages.mjs && vite build && node scripts/generate-seo-pages.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:dsp": "tsx tests/audioExtraDsp.test.ts && tsx tests/audioLimits.test.ts && tsx tests/audioMetadata.test.ts",
    "test:pad": "tsx tests/padFiles.test.ts",
    "test:quiz": "tsx tests/quizCommunity.test.ts && tsx tests/quizSegments.test.ts",
    "test:routes": "tsx tests/routes.test.ts"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "resend": "^6.1.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "soundfont2": "^0.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
